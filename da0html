        <div class="details-top">
          <div>
            <div class="details-title">席位與人物詳情</div>
            <div class="details-note">${esc(item.note || "可在此分席填寫人物，不必把多人塞進同一格。")}</div>
          </div>
          <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
            <div class="info-row" style="margin:0;padding:.4rem .7rem;font-size:.8rem">
              <span style="color:var(--muted);font-size:.7rem;letter-spacing:.15em">定員</span>
              <strong>${quotaLabel}</strong>
              <span style="color:var(--muted);font-size:.7rem;letter-spacing:.15em;margin-left:.5rem">已填</span>
              <strong>${filledCount(item)}</strong>
              <span style="color:var(--muted);font-size:.7rem;letter-spacing:.15em;margin-left:.5rem">空缺</span>
              <strong>${v}</strong>
            </div>
            <button class="btn sm gold" onclick="addSlot('${item.id}')">新增席位</button>
          </div>
        </div>
        <div class="slot-list">
          ${(item.slots && item.slots.length) ? item.slots.map((s,idx)=>slotHtml(item,s,idx)).join("") : `<div class="empty-slot">目前沒有席位。可按「新增席位」新增。</div>`}
        </div>
      </div>
    </article>
  `;
}

function slotHtml(item,s,idx){
  const label = s.name && s.name.trim() ? s.name : `第 ${idx+1} 席空缺`;
  const isEmpty = !(s.name && s.name.trim());
  return `
    <div class="slot-card">
      <div class="slot-top">
        <div class="${isEmpty?'slot-empty-name slot-name':'slot-name'}">${esc(label)}</div>
        <div style="display:flex;gap:.35rem;align-items:center;flex-wrap:wrap">
          <span class="status-pill status-${s.status}">${esc(s.status)}</span>
          <button class="btn sm danger" onclick="deleteSlot('${item.id}','${s.id}')">刪除此席</button>
        </div>
      </div>
      <div class="slot-grid">
        <label>人物姓名<input value="${esc(s.name)}" placeholder="空白即為空缺" onchange="updateSlot('${item.id}','${s.id}','name',this.value)"></label>
        <label>年齡<input value="${esc(s.age)}" onchange="updateSlot('${item.id}','${s.id}','age',this.value)"></label>
        <label>出身／家族<input value="${esc(s.origin)}" onchange="updateSlot('${item.id}','${s.id}','origin',this.value)"></label>
        <label>狀態<select onchange="updateSlot('${item.id}','${s.id}','status',this.value)">
          ${statuses.map(st=>`<option value="${esc(st)}" ${st===s.status?'selected':''}>${esc(st)}</option>`).join("")}
        </select></label>
        <label class="wide">關係／子女<input value="${esc(s.relation)}" onchange="updateSlot('${item.id}','${s.id}','relation',this.value)"></label>
        <label>居所／院落<input value="${esc(s.residence)}" onchange="updateSlot('${item.id}','${s.id}','residence',this.value)"></label>
        <label class="full">備註<textarea onchange="updateSlot('${item.id}','${s.id}','note',this.value)">${esc(s.note)}</textarea></label>
      </div>
    </div>
  `;
}

function updatePosition(id,key,value){
  const item=data.find(i=>i.id===id); if(!item) return;
  if(key==="quota"){item[key]=normalizeNum(value);}else{item[key]=value;}
  saveData(); render(); toast("已更新");
}
function updateSlot(itemId,slotId,key,value){
  const item=data.find(i=>i.id===itemId); if(!item) return;
  const s=(item.slots || []).find(x=>x.id===slotId); if(!s) return;
  s[key]=value;
  saveData(); render(); toast("已更新");
}
function toggleOpen(id){
  openIds.has(id) ? openIds.delete(id) : openIds.add(id);
  render();
}
function addSlot(id){
  const item=data.find(i=>i.id===id); if(!item) return;
  item.slots ||= [];
  item.slots.push(slot());
  openIds.add(id);
  saveData(); render(); toast("已新增席位");
}
function deleteSlot(itemId,slotId){
  const item=data.find(i=>i.id===itemId); if(!item) return;
  if(confirm("確定刪除此席位／人物嗎？")){
    item.slots=(item.slots || []).filter(s=>s.id!==slotId);
    saveData(); render(); toast("已刪除");
  }
}
function clearForm(){
  editingId=null;
  document.getElementById("fCategory").value=currentCategory==="全部"?"後宮":currentCategory;
  document.getElementById("fSystem").value="";
  document.getElementById("fPosition").value="";
  document.getElementById("fRank").value="";
  document.getElementById("fQuota").value=1;
  document.getElementById("fStatus").value="空缺";
  document.getElementById("fNote").value="";
}
function showForm(){document.getElementById("formPanel").classList.add("show");window.scrollTo({top:0,behavior:"smooth"});}
function hideForm(){document.getElementById("formPanel").classList.remove("show");}
function quickAdd(cat){clearForm();document.getElementById("fCategory").value=cat;showForm();}
function editPosition(id){
  const item=data.find(i=>i.id===id); if(!item) return;
  editingId=id;
  document.getElementById("fCategory").value=item.category;
  document.getElementById("fSystem").value=item.system;
  document.getElementById("fPosition").value=item.position;
  document.getElementById("fRank").value=item.rank;
  document.getElementById("fQuota").value=item.quota;
  document.getElementById("fStatus").value=item.status;
  document.getElementById("fNote").value=item.note;
  showForm();
}
function saveForm(){
  const quota=normalizeNum(document.getElementById("fQuota").value);
  const item={
    id: editingId || uid(),
    category:document.getElementById("fCategory").value,
    system:document.getElementById("fSystem").value,
    position:document.getElementById("fPosition").value,
    rank:document.getElementById("fRank").value,
    quota,
    status:document.getElementById("fStatus").value,
    note:document.getElementById("fNote").value,
    slots:[]
  };
  if(!item.position.trim()){alert("請至少填寫職位／名分。");return;}
  if(editingId){
    const old=data.find(i=>i.id===editingId);
    item.slots=old?.slots || [];
    data=data.map(i=>i.id===editingId?item:i);
  }else{
    if(quota>0){for(let i=0;i<quota;i++) item.slots.push(slot());}
    data.push(item);
    openIds.add(item.id);
  }
  saveData(); clearForm(); hideForm(); render(); toast("已儲存");
}
function deletePosition(id){
  const item=data.find(i=>i.id===id); if(!item) return;
  if(confirm(`確定刪除「${item.system}／${item.position}」整個職銜嗎？`)){
    data=data.filter(i=>i.id!==id);
    openIds.delete(id);
    saveData(); render(); toast("已刪除");
  }
}
function exportJson(){
  const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url; a.download="大周名位卷宗資料_展卷版.json";
  document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
}
function importJson(file){
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const imported=JSON.parse(e.target.result);
      if(!Array.isArray(imported)) throw new Error("格式錯誤");
      data=imported.map(i=>({id:i.id||uid(), slots:(i.slots||[]).map(s=>({id:s.id||uid(),...s})), ...i}));
      saveData(); render(); toast("已匯入");
    }catch(err){alert("匯入失敗：請確認是本工具匯出的 JSON 檔。");}
  };
  reader.readAsText(file);
}
function resetData(){
  if(confirm("確定要重置為初始資料嗎？目前填寫內容會被清除。")){
    localStorage.removeItem(STORAGE_KEY);
    data=JSON.parse(JSON.stringify(initialData)).map(i=>({...i,id:uid(),slots:(i.slots||[]).map(s=>({...s,id:uid()}))}));
    openIds.clear();
    saveData(); render(); toast("已重置");
  }
}
function render(){renderStats();renderSections();}

document.addEventListener("DOMContentLoaded",()=>{
  initOptions(); render();
  document.querySelectorAll(".nav-btn").forEach(btn=>{
    btn.addEventListener("click",()=>{
      document.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      currentCategory=btn.dataset.category;
      render();
    });
  });
  document.getElementById("searchInput").addEventListener("input",render);
  document.getElementById("categoryFilter").addEventListener("change",render);
  document.getElementById("statusFilter").addEventListener("change",render);
  document.getElementById("showAdd").addEventListener("click",()=>{clearForm();showForm();});
  document.getElementById("cancelForm").addEventListener("click",()=>{clearForm();hideForm();});
  document.getElementById("saveForm").addEventListener("click",saveForm);
  document.getElementById("exportJson").addEventListener("click",exportJson);
  document.getElementById("importBtn").addEventListener("click",()=>document.getElementById("importFile").click());
  document.getElementById("importFile").addEventListener("change",e=>{const f=e.target.files[0]; if(f) importJson(f); e.target.value="";});
  document.getElementById("resetData").addEventListener("click",resetData);
});

window.quickAdd=quickAdd;
window.toggleOpen=toggleOpen;
window.editPosition=editPosition;
window.deletePosition=deletePosition;
window.updatePosition=updatePosition;
window.updateSlot=updateSlot;
window.addSlot=addSlot;
window.deleteSlot=deleteSlot;
</script>
</body>
</html>
