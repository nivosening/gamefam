function dossierKey(item){
  return [item.category || "", item.system || "", item.position || "", item.rank || ""].join("｜");
}
function hasNamedSlot(item, name){
  return (item.slots || []).some(s => (s.name || "").trim() === name);
}
function mergeWithInitial(saved){
  const list = Array.isArray(saved) ? saved : [];
  list.forEach(item => {
    item.id ||= uid();
    item.slots ||= [];
    item.slots.forEach(s => s.id ||= uid());
  });

  const byKey = new Map(list.map(item => [dossierKey(item), item]));

  initialData.forEach(base => {
    const key = dossierKey(base);
    const existing = byKey.get(key);
    if(!existing){
      list.push(base);
      byKey.set(key, base);
      return;
    }

    existing.slots ||= [];

    // 修正早期版本的寧王妃暫名，改回目前正史設定。
    if(existing.category === "王府" && existing.system === "寧王府" && existing.position === "王妃"){
      const hasOld = existing.slots.some(s => (s.name || "").includes("江月疏"));
      if(hasOld || existing.slots.length === 0){
        existing.status = base.status;
        existing.note = base.note;
        existing.slots = JSON.parse(JSON.stringify(base.slots));
      }
    }

    // 既有職銜若少了制度總覽中的固定人物，補入；空白席位不強制補，避免洗掉使用者資料。
    (base.slots || []).forEach(baseSlot => {
      const name = (baseSlot.name || "").trim();
      if(name && !hasNamedSlot(existing, name)){
        existing.slots.push(baseSlot);
      }
    });

    if((existing.slots || []).length === 0 && (base.slots || []).length > 0){
      existing.slots = JSON.parse(JSON.stringify(base.slots));
    }
  });

  return list;
}
function loadData(){
  try{
    const saved = localStorage.getItem(STORAGE_KEY);
    if(saved){
      const merged = mergeWithInitial(JSON.parse(saved));
      localStorage.setItem(STORAGE_KEY, JSON.stringify(merged));
      return merged;
    }
  }catch(e){}
  return initialData;
}
function saveData(){localStorage.setItem(STORAGE_KEY, JSON.stringify(data));}
function esc(str){return String(str ?? "").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));}
function normalizeNum(n){const x=Number(n);return Number.isFinite(x)?x:0;}
function filledCount(item){return (item.slots || []).filter(s=>s.name && s.name.trim()).length;}
function vacancy(item){
  const q=normalizeNum(item.quota);
  if(q===0) return "不限";
  return Math.max(q - filledCount(item),0);
}
function positionStatus(item){
  if(item.status && item.status !== "空缺") return item.status;
  const v=vacancy(item);
  if(v==="不限") return filledCount(item)>0 ? "在任" : "空缺";
  return v>0 ? "空缺" : "在任";
}
