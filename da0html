    statusFilter.insertAdjacentHTML("beforeend",`<option value="${s}">${s}</option>`);
    fStatus.insertAdjacentHTML("beforeend",`<option value="${s}">${s}</option>`);
  });
}
function filteredData(){
  const q=document.getElementById("searchInput").value.trim().toLowerCase();
  const catFilter=document.getElementById("categoryFilter").value;
  const statusFilter=document.getElementById("statusFilter").value;
  return data.filter(item=>{
    const matchCat=currentCategory==="全部" || item.category===currentCategory;
    const matchCat2=catFilter==="全部" || item.category===catFilter;
    const pStatus=positionStatus(item);
    const slotStatus=(item.slots || []).some(s=>s.status===statusFilter);
    const matchStatus=statusFilter==="全部" || pStatus===statusFilter || slotStatus;
    const hay=JSON.stringify(item).toLowerCase();
    const matchQ=!q || hay.includes(q);
    return matchCat && matchCat2 && matchStatus && matchQ;
  });
}
function renderStats(){
  const items=filteredData();
  const total=items.length;
  const filled=items.reduce((sum,i)=>sum+filledCount(i),0);
  const quota=items.reduce((sum,i)=>normalizeNum(i.quota)===0?sum:sum+normalizeNum(i.quota),0);
  const vacant=items.reduce((sum,i)=>{
    const v=vacancy(i);return v==="不限"?sum:sum+normalizeNum(v);
  },0);
  const pending=items.filter(i=>["待議","待定","已定未冊","疑案中"].includes(positionStatus(i)) || (i.slots||[]).some(s=>["待議","待定","已定未冊","疑案中"].includes(s.status))).length;
  const stats=[["職銜筆數",total],["固定定員",quota],["已填人物",filled],["固定空缺",vacant],["待處理",pending]];
  document.getElementById("stats").innerHTML=stats.map(([label,num])=>`
    <div class="stat-card">
      <div class="stat-label">${label}</div>
      <div class="stat-num">${num}</div>
    </div>
  `).join("");
}
function renderSections(){
  const items=filteredData();
  const grouped={};
  items.forEach(item=>{(grouped[item.category] ||= []).push(item);});
  const order=currentCategory==="全部"?categories:[currentCategory];
  const html=order.filter(cat=>grouped[cat]?.length).map(cat=>{
    const arr=grouped[cat];
    const vacant=arr.reduce((sum,i)=>{const v=vacancy(i);return v==="不限"?sum:sum+normalizeNum(v)},0);
    return `
      <section>
        <div class="section-head">
          <div>
            <div class="section-title">${cat}卷</div>
            <div class="section-meta">共 ${arr.length} 個職銜｜固定空缺 ${vacant}｜點開職銜查看席位與人物</div>
          </div>
          <button class="btn sm" onclick="quickAdd('${cat}')">新增${cat}職銜</button>
        </div>
        <div class="position-list">${arr.map(positionHtml).join("")}</div>
      </section>
    `;
  }).join("");
  document.getElementById("sections").innerHTML=html || `<div class="stat-card" style="justify-content:center">目前沒有符合條件的卷宗資料。</div>`;
}

