  const isOpen=openIds.has(item.id);
  const pStatus=positionStatus(item);
  const v=vacancy(item);
  const filledNames=(item.slots||[]).filter(s=>s.name&&s.name.trim()).map(s=>s.name).join("、");
  const quotaLabel=item.quota===0?"不限":item.quota;

